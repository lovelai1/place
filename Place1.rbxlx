				<Item class="ModuleScript" referent="RBX81169D3EB3D44EF4A59098A86D4DC401">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">QuestRemotes</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Shared helper for GhostyRPG quest remotes.
-- Server creation is explicit/idempotent through Ensure(); clients only wait.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENT_NAMES: { [string]: string } = {
	AcceptQuest = "Quest_AcceptQuest",
	AbandonQuest = "Quest_AbandonQuest",
	TurnInQuest = "Quest_TurnInQuest",
	QuestAccepted = "Quest_QuestAccepted",
	QuestAbandoned = "Quest_QuestAbandoned",
	QuestProgressUpdated = "Quest_QuestProgressUpdated",
	QuestReadyToTurnIn = "Quest_QuestReadyToTurnIn",
	QuestTurnedIn = "Quest_QuestTurnedIn",
	QuestFailed = "Quest_QuestFailed",
}

local FUNCTION_NAMES: { [string]: string } = {
	GetAvailableQuests = "Quest_GetAvailableQuests",
	GetActiveQuests = "Quest_GetActiveQuests",
}

local QuestRemotes = {}
QuestRemotes.EventNames = EVENT_NAMES
QuestRemotes.FunctionNames = FUNCTION_NAMES

local function getSharedFolder(): Folder
	local shared = ReplicatedStorage:WaitForChild("Shared", 10)
	assert(shared and shared:IsA("Folder"), "QuestRemotes: ReplicatedStorage.Shared was not found")
	return shared :: Folder
end

local function getOrCreateFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		assert(existing:IsA("Folder"), string.format("QuestRemotes: %s exists but is %s", name, existing.ClassName))
		return existing :: Folder
	end

	assert(RunService:IsServer(), string.format("QuestRemotes: client cannot create folder %s", name))
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function waitForFolder(parent: Instance, name: string): Folder
	local folder = parent:WaitForChild(name, 15)
	assert(folder and folder:IsA("Folder"), string.format("QuestRemotes: expected Folder %s", name))
	return folder :: Folder
end

local function getQuestFolder(createOnServer: boolean): Folder
	local shared = getSharedFolder()
	if RunService:IsServer() and createOnServer then
		local remotes = getOrCreateFolder(shared, "Remotes")
		return getOrCreateFolder(remotes, "Quest")
	end

	local remotes = waitForFolder(shared, "Remotes")
	return waitForFolder(remotes, "Quest")
end

local function getOrCreateRemote(parent: Instance, className: string, name: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing then
		assert(existing.ClassName == className, string.format("QuestRemotes: %s exists but is %s", name, existing.ClassName))
		return existing
	end

	assert(RunService:IsServer(), string.format("QuestRemotes: client cannot create remote %s", name))
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = parent
	return remote
end

function QuestRemotes.Ensure(): Folder
	local folder = getQuestFolder(RunService:IsServer())
	if RunService:IsServer() then
		for _, remoteName in pairs(EVENT_NAMES) do
			getOrCreateRemote(folder, "RemoteEvent", remoteName)
		end
		for _, remoteName in pairs(FUNCTION_NAMES) do
			getOrCreateRemote(folder, "RemoteFunction", remoteName)
		end
	end
	return folder
end

function QuestRemotes.GetEvent(key: string): RemoteEvent
	local name = EVENT_NAMES[key]
	assert(name, string.format("QuestRemotes.GetEvent: unknown key '%s'", key))

	local folder = if RunService:IsServer() then QuestRemotes.Ensure() else getQuestFolder(false)
	local inst = folder:WaitForChild(name, 15)
	assert(inst and inst:IsA("RemoteEvent"), string.format("QuestRemotes.GetEvent: expected RemoteEvent '%s'", name))
	return inst :: RemoteEvent
end

function QuestRemotes.GetFunction(key: string): RemoteFunction
	local name = FUNCTION_NAMES[key]
	assert(name, string.format("QuestRemotes.GetFunction: unknown key '%s'", key))

	local folder = if RunService:IsServer() then QuestRemotes.Ensure() else getQuestFolder(false)
	local inst = folder:WaitForChild(name, 15)
	assert(inst and inst:IsA("RemoteFunction"), string.format("QuestRemotes.GetFunction: expected RemoteFunction '%s'", name))
	return inst :: RemoteFunction
end

return QuestRemotes
]]></ProtectedString>
