				<Item class="Script" referent="RBX0C780ACA84DB48A0B77C9EA418F29D5C">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">GhostyRPG_ConfigSmokeTest</string>
						<ProtectedString name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local sharedConfig = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local serverConfig = ServerScriptService:WaitForChild("Server"):WaitForChild("Config")

local sharedModules = { "GameEnums", "ClassConfig", "RoleConfig", "StatFormulas" }
local serverModules = { "ProfessionConfig", "DungeonConfig", "RaidConfig", "ArenaConfig" }

for _, moduleName in ipairs(sharedModules) do
	local ok, result = pcall(require, sharedConfig:WaitForChild(moduleName))
	assert(ok, string.format("Failed to load shared config %s: %s", moduleName, tostring(result)))
end

for _, moduleName in ipairs(serverModules) do
	local ok, result = pcall(require, serverConfig:WaitForChild(moduleName))
	assert(ok, string.format("Failed to load server config %s: %s", moduleName, tostring(result)))
end

print(string.format("[GhostyRPG] Config smoke test loaded %d modules.", #sharedModules + #serverModules))
]]></ProtectedString>
