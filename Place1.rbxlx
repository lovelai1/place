						<ProtectedString name="Source"><![CDATA[--!strict

local DungeonConfig = {
	MaxPlayers = 5, BaseTimeLimit = 1800, RequiredRoleComposition = { Tank = 1, Healer = 1, DPS = 3 },
	DifficultyMultipliers = { Normal = { EnemyHealth = 1.0, EnemyDamage = 1.0, EnemyCount = 1.0, EliteMultiplier = 1.0 }, Heroic = { EnemyHealth = 2.5, EnemyDamage = 1.8, EnemyCount = 1.2, EliteMultiplier = 1.5 }, Mythic = { EnemyHealth = 5.0, EnemyDamage = 3.0, EnemyCount = 1.4, EliteMultiplier = 2.5, AddsAffixModifiers = true } },
	RewardMultipliers = { Normal = { ItemLevelBonus = 0, GoldMultiplier = 1.0, ExperienceBonus = 1.0, BonusChestChance = 0.0 }, Heroic = { ItemLevelBonus = 15, GoldMultiplier = 2.5, ExperienceBonus = 1.5, BonusChestChance = 0.25 }, Mythic = { ItemLevelBonus = 30, GoldMultiplier = 5.0, ExperienceBonus = 2.0, BonusChestChance = 0.5 } },
