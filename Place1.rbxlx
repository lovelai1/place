						<string name="Name">DungeonValidator</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Pure validation for GhostyRPG dungeon run creation.
-- The service owns mutation; this module only checks request shape and config limits.

local ServerScriptService = game:GetService("ServerScriptService")

local DungeonConfig = require(ServerScriptService:WaitForChild("Server"):WaitForChild("Config"):WaitForChild("DungeonConfig"))

local DungeonValidator = {}

export type ValidationResult = {
	success: boolean,
	reason: string?,
	objectives: { string }?,
}

local function ok(payload: { string }?): ValidationResult
	return { success = true, objectives = payload or {} }
end

local function fail(reason: string): ValidationResult
	return { success = false, reason = reason }
end

local function isPlayer(value: any): boolean
	return typeof(value) == "Instance" and value:IsA("Player")
end

local function getDungeonDefinition(dungeonId: string): any?
	local dungeons = DungeonConfig.Dungeons
	return if type(dungeons) == "table" then dungeons[dungeonId] else nil
end

local function getObjectiveIds(dungeonDef: any?): { string }
	local objectiveIds = {}
	if type(dungeonDef) ~= "table" or type(dungeonDef.Objectives) ~= "table" then
		return objectiveIds
	end
	for _, objective in ipairs(dungeonDef.Objectives) do
		if type(objective) == "string" then
			table.insert(objectiveIds, objective)
		elseif type(objective) == "table" and type(objective.id) == "string" then
			table.insert(objectiveIds, objective.id)
		elseif type(objective) == "table" and type(objective.Id) == "string" then
			table.insert(objectiveIds, objective.Id)
		end
	end
	return objectiveIds
end

function DungeonValidator.IsValidDifficulty(difficulty: string): boolean
	return type(difficulty) == "string"
		and type(DungeonConfig.DifficultyMultipliers) == "table"
		and DungeonConfig.DifficultyMultipliers[difficulty] ~= nil
end

function DungeonValidator.ValidateRun(request: any): ValidationResult
	if type(request) ~= "table" then
		return fail("request must be a table.")
	end
	if type(request.dungeonId) ~= "string" or request.dungeonId == "" then
		return fail("dungeonId must be a non-empty string.")
	end
	if not DungeonValidator.IsValidDifficulty(request.difficulty) then
		return fail(string.format("Unknown dungeon difficulty '%s'.", tostring(request.difficulty)))
	end
	if not isPlayer(request.leader) then
		return fail("leader must be a Player.")
	end
	if type(request.members) ~= "table" or #request.members == 0 then
		return fail("members must contain at least one Player.")
	end

	local maxPlayers = DungeonConfig.MaxPlayers or math.huge
	if #request.members > maxPlayers then
		return fail(string.format("Dungeon party is too large (%d/%d).", #request.members, maxPlayers))
	end

	local leaderFound = false
	local seen: { [Player]: boolean } = {}
	for _, member in ipairs(request.members) do
		if not isPlayer(member) then
			return fail("members must contain only Player instances.")
		end
		if seen[member] then
			return fail("members must not contain duplicate players.")
		end
		seen[member] = true
		if member == request.leader then
			leaderFound = true
		end
	end
	if not leaderFound then
		return fail("leader must be included in members.")
	end

	local dungeonDef = getDungeonDefinition(request.dungeonId)
	if type(DungeonConfig.Dungeons) == "table" and dungeonDef == nil then
		return fail(string.format("Unknown dungeon '%s'.", request.dungeonId))
	end

	return ok(getObjectiveIds(dungeonDef))
end

function DungeonValidator.GetRewards(dungeonId: string, difficulty: string): { any }
	local dungeonDef = getDungeonDefinition(dungeonId)
	if type(dungeonDef) ~= "table" then
		return {}
	end
	local rewards = dungeonDef.Rewards
	if type(rewards) ~= "table" then
		return {}
	end
	local difficultyRewards = rewards[difficulty]
	if type(difficultyRewards) == "table" then
		return difficultyRewards
	end
	return rewards
end

return DungeonValidator
